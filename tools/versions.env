# Generator 由 tools Module 构建，版本输出用于拒绝错误的本地缓存。
PROTOC_GEN_GO_MODULE='google.golang.org/protobuf/cmd/protoc-gen-go'
PROTOC_GEN_GO_VERSION='1.36.12'
PROTOC_GEN_GO_EXPECTED_VERSION='protoc-gen-go v1.36.12'

# OpenAPI Go Generator 由 tools Module 构建，版本输出用于拒绝错误的本地缓存。
OAPI_CODEGEN_MODULE='github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen'
OAPI_CODEGEN_VERSION='2.8.0'

