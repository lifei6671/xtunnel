{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xtunnel:config:agent:v1",
  "title": "XTunnel Agent Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "auth", "data_dir", "transport", "reconnect", "control", "health", "logging"],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "tls"],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "description": "Agent Gateway 的 host:port 地址。",
          "x-secret": false,
          "x-reloadable": false
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["public", "pinned"],
              "default": "pinned",
              "x-secret": false,
              "x-reloadable": false
            },
            "server_pin": {
              "type": "string",
              "pattern": "^sha256:[A-Za-z0-9+/=_-]+$",
              "description": "pinned TLS 使用的公开 SPKI SHA-256 信任锚。",
              "x-secret": false,
              "x-reloadable": false
            }
          },
          "allOf": [
            {
              "if": {"properties": {"mode": {"const": "pinned"}}, "required": ["mode"]},
              "then": {"required": ["server_pin"]},
              "else": {"not": {"required": ["server_pin"]}}
            }
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_file"],
      "properties": {
        "token_file": {
          "type": "string",
          "minLength": 1,
          "default": "/var/lib/xtunnel/token",
          "description": "Agent Token 文件路径；路径不是 Secret，文件内容是 Secret。",
          "x-secret": false,
          "x-reloadable": false
        }
      }
    },
    "data_dir": {
      "type": "string",
      "minLength": 1,
      "default": "/var/lib/xtunnel",
      "x-secret": false,
      "x-reloadable": false
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tcp"],
      "properties": {
        "tcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_idle", "target_idle", "max_idle", "max_connecting", "max_total"],
          "properties": {
            "min_idle": {"type": "integer", "minimum": 0, "maximum": 1048576, "default": 4, "x-secret": false, "x-reloadable": false},
            "target_idle": {"type": "integer", "minimum": 0, "maximum": 1048576, "default": 8, "x-secret": false, "x-reloadable": false},
            "max_idle": {"type": "integer", "minimum": 0, "maximum": 1048576, "default": 32, "x-secret": false, "x-reloadable": false},
            "max_connecting": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 16, "x-secret": false, "x-reloadable": false},
            "max_total": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 256, "x-secret": false, "x-reloadable": false}
          }
        }
      }
    },
    "reconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_delay", "max_delay", "jitter"],
      "properties": {
        "initial_delay": {
          "type": "string",
          "format": "go-duration",
          "default": "1s",
          "x-secret": false,
          "x-reloadable": false
        },
        "max_delay": {
          "type": "string",
          "format": "go-duration",
          "default": "30s",
          "x-secret": false,
          "x-reloadable": false
        },
        "jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.2,
          "x-secret": false,
          "x-reloadable": false
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high_priority_queue", "normal_queue", "write_timeout"],
      "properties": {
        "high_priority_queue": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 32, "x-secret": false, "x-reloadable": false},
        "normal_queue": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 128, "x-secret": false, "x-reloadable": false},
        "write_timeout": {"type": "string", "format": "go-duration", "default": "5s", "x-secret": false, "x-reloadable": false}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrent",
        "max_checks_per_second",
        "max_concurrent_per_origin",
        "initial_jitter",
        "interval_jitter",
        "report_flush_interval",
        "report_batch_size"
      ],
      "properties": {
        "max_concurrent": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 64, "x-secret": false, "x-reloadable": false},
        "max_checks_per_second": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 50, "x-secret": false, "x-reloadable": false},
        "max_concurrent_per_origin": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 4, "x-secret": false, "x-reloadable": false},
        "initial_jitter": {"type": "number", "minimum": 0, "maximum": 1, "default": 1.0, "x-secret": false, "x-reloadable": false},
        "interval_jitter": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.2, "x-secret": false, "x-reloadable": false},
        "report_flush_interval": {"type": "string", "format": "go-duration", "default": "1s", "x-secret": false, "x-reloadable": false},
        "report_batch_size": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 128, "x-secret": false, "x-reloadable": false}
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "format"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "x-secret": false,
          "x-reloadable": false
        },
        "format": {
          "type": "string",
          "const": "json",
          "default": "json",
          "x-secret": false,
          "x-reloadable": false
        }
      }
    }
  }
}
