# Managed by xtunnel-agent service install
[Unit]
Description=XTunnel Agent
Documentation=https://github.com/lifei6671/xtunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=xtunnel-agent
Group=xtunnel-agent
UMask=0077
RuntimeDirectory=xtunnel-agent
RuntimeDirectoryMode=0700
LoadCredential=xtunnel-agent.token:/etc/xtunnel/credentials/agent.token
ExecStart=/usr/local/bin/xtunnel-agent run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
